# Production environment for GameHub — copy to /opt/game_hub/.env on the VPS.
# config/runtime.exs reads this file directly (relative to the release's
# working directory, i.e. systemd's WorkingDirectory=/opt/game_hub) — there is
# no systemd EnvironmentFile= directive involved.
# NOTE: no `export`, no surrounding quotes. Each value is the rest of the line.

# Required: tells the release to actually start the web server.
PHX_SERVER=true

# Public hostname (used for URLs). No scheme.
PHX_HOST=games.gatetroy.com

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=REPLACE_WITH_64_BYTE_SECRET

# No DATABASE_URL, no email keys — GameHub has no database and sends no email.
# Game state lives only inside each LiveView connection.
